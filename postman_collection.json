    {
      "name": "03 Booking Flow",
      "description": "Основной пользовательский flow: lock -> confirm, плюс cancel.",
      "item": [
        {
          "name": "Lock available seat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/bookings/lock",
            "description": "Блокирует выбранное место. Требует `accessToken`, `eventId`, `seatId`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": {{eventId}},\n  \"seatId\": {{seatId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('Lock response contains lockId and expiresAt', () => { pm.expect(data.lockId).to.exist; pm.expect(data.expiresAt).to.exist; });",
                  "pm.collectionVariables.set('lockId', String(data.lockId));"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm booking",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/bookings/{{lockId}}/confirm",
            "description": "Подтверждает лок/бронирование. После этого ticket переходит в BOOKED.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body says booking confirmed', () => pm.expect(pm.response.text()).to.include('Booking confirmed'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get seats after confirm",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/events/{{eventId}}/seats",
            "description": "Проверяет, что подтверждённое место стало BOOKED, и выбирает новое AVAILABLE место для cancel-flow."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const seats = pm.response.json();",
                  "const booked = seats.find(s => String(s.seatId) === pm.collectionVariables.get('seatId'));",
                  "if (booked) pm.test('Confirmed seat is BOOKED', () => pm.expect(booked.status).to.eql('BOOKED'));",
                  "const available = seats.filter(s => s.status === 'AVAILABLE');",
                  "pm.test('There is another available seat for cancel flow', () => pm.expect(available.length).to.be.above(0));",
                  "if (available[0]) pm.collectionVariables.set('cancelSeatId', String(available[0].seatId));"
                ]
              }
            }
          ]
        },
        {
          "name": "Lock seat for cancel",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/bookings/lock",
            "description": "Создаёт отдельный LOCKED ticket для проверки ручной отмены.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": {{eventId}},\n  \"seatId\": {{cancelSeatId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('Cancel lock response contains lockId', () => pm.expect(data.lockId).to.exist);",
                  "pm.collectionVariables.set('cancelLockId', String(data.lockId));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel lock",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/bookings/{{cancelLockId}}",
            "description": "Отменяет LOCKED ticket и возвращает место в AVAILABLE.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Try lock already BOOKED seat should return 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/bookings/lock",
            "description": "Пытается повторно заблокировать уже подтверждённое место. Ожидается конфликт.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": {{eventId}},\n  \"seatId\": {{seatId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409', () => pm.response.to.have.status(409));",
                  "const data = pm.response.json();",
                  "pm.test('Conflict body contains error', () => pm.expect(data).to.have.property('error'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Lock without auth should return 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/bookings/lock",
            "description": "Защищённый endpoint без Bearer token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": {{eventId}},\n  \"seatId\": {{cancelSeatId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
