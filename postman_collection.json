                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Логин seed-админа. Сохраняет `adminAccessToken` и `adminRefreshToken`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('Admin auth response contains tokens', () => {",
                  "  pm.expect(data).to.have.property('token');",
                  "  pm.expect(data).to.have.property('refreshToken');",
                  "  pm.expect(data.user.role).to.eql('ADMIN');",
                  "});",
                  "pm.collectionVariables.set('adminAccessToken', data.token);",
                  "pm.collectionVariables.set('adminRefreshToken', data.refreshToken);",
                  "pm.collectionVariables.set('adminId', String(data.user.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid login should return 400",
          "request": {
