    {
      "name": "01 Auth",
      "description": "Регистрация, логин, refresh token.",
      "item": [
        {
          "name": "Register random USER",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Создаёт нового пользователя с уникальным email и сохраняет его токены в collection variables.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{newUserEmail}}\",\n  \"password\": \"password123\",\n  \"name\": \"Postman User\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = `postman_${Date.now()}_${Math.floor(Math.random() * 10000)}@test.com`;",
                  "pm.collectionVariables.set('newUserEmail', email);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200/201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const data = pm.response.json();",
                  "pm.test('Auth response contains tokens and user', () => {",
                  "  pm.expect(data).to.have.property('token');",
                  "  pm.expect(data).to.have.property('refreshToken');",
                  "  pm.expect(data).to.have.property('user');",
                  "  pm.expect(data.user).to.have.property('role');",
                  "});",
                  "pm.collectionVariables.set('accessToken', data.token);",
                  "pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "pm.collectionVariables.set('userId', String(data.user.id));",
                  "pm.collectionVariables.set('userRole', data.user.role);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login seed USER",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
