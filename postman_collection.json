        {
          "name": "Get event seats",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/events/{{eventId}}/seats",
            "description": "Получает карту мест и сохраняет первое/второе AVAILABLE место в `seatId` и `cancelSeatId`."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const seats = pm.response.json();",
                  "pm.test('Seats response is array', () => pm.expect(seats).to.be.an('array'));",
                  "const available = seats.filter(s => s.status === 'AVAILABLE');",
                  "pm.test('There is at least one available seat', () => pm.expect(available.length).to.be.above(0));",
                  "if (available[0]) pm.collectionVariables.set('seatId', String(available[0].seatId));",
                  "if (available[1]) pm.collectionVariables.set('cancelSeatId', String(available[1].seatId));",
                  "else if (available[0]) pm.collectionVariables.set('cancelSeatId', String(available[0].seatId));"
                ]
              }
            }
          ]
        }
      ]
