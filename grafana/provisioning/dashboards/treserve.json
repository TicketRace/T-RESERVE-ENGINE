{
  "uid": "treserve-main",
  "title": "T-RESERVE — High Load Monitor",
  "tags": ["treserve", "spring-boot"],
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-5m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "HTTP Requests Per Second (total)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"treserve-app-.*\"}[30s])) by (instance)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP p99 Latency (ms)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{job=~\"treserve-app-.*\"}[30s])) by (le, instance)) * 1000",
          "legendFormat": "p99 {{instance}}",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=~\"treserve-app-.*\"}[30s])) by (le, instance)) * 1000",
          "legendFormat": "p95 {{instance}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "JVM Heap Memory (MB)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 }
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "jvm_memory_used_bytes{area=\"heap\",job=~\"treserve-app-.*\"} / 1024 / 1024",
          "legendFormat": "heap used — {{instance}}",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "jvm_memory_max_bytes{area=\"heap\",job=~\"treserve-app-.*\"} / 1024 / 1024",
          "legendFormat": "heap max — {{instance}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "title": "HikariCP — Active DB Connections",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "hikaricp_connections_active{job=~\"treserve-app-.*\"}",
          "legendFormat": "active — {{instance}}",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "hikaricp_connections_pending{job=~\"treserve-app-.*\"}",
          "legendFormat": "pending — {{instance}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "title": "Requests by Endpoint (RPS)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 1, "fillOpacity": 5 }
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"treserve-app-.*\"}[30s])) by (uri)",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "HTTP Client Errors (4xx)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 24, "w": 8, "h": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "fixedColor": "orange", "mode": "fixed" },
          "custom": { "lineWidth": 2, "fillOpacity": 20 }
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"treserve-app-.*\",status=~\"4..\"}[30s]))",
          "legendFormat": "4xx/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "HTTP Server Errors (5xx)",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 24, "w": 8, "h": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "fixedColor": "red", "mode": "fixed" },
          "custom": { "lineWidth": 2, "fillOpacity": 20 }
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"treserve-app-.*\",status=~\"5..\"}[30s]))",
          "legendFormat": "5xx/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Load Balance — RPS per Instance",
      "type": "piechart",
      "gridPos": { "x": 16, "y": 24, "w": 8, "h": 7 },
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"treserve-app-.*\"}[1m])) by (instance)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 38
}
