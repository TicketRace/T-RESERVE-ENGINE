{
  "name": "t-reserve-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "e2e:mocked": "playwright test",
    "e2e:real": "playwright test -c playwright.real.config.ts",
    "e2e:real:ui": "playwright test -c playwright.real.config.ts --ui",
    "e2e:real:headed": "playwright test -c playwright.real.config.ts --headed",
    "e2e:all": "npm run e2e:mocked && npm run e2e:real"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.19",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.2.0",
    "@angular/compiler": "^20.2.0",
    "@angular/core": "^20.2.0",
    "@angular/forms": "^20.2.0",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.2.0",
    "@angular/router": "^20.2.0",
    "@ng-web-apis/common": "^5.2.0",
    "@ng-web-apis/mutation-observer": "^5.2.0",
    "@ng-web-apis/platform": "^5.2.0",
    "@ng-web-apis/resize-observer": "^5.2.0",
    "@ng-web-apis/screen-orientation": "^5.2.0",
    "@stomp/stompjs": "^7.3.0",
    "@taiga-ui/styles": "^5.4.0",
    "rxjs": "~7.8.0",
    "sockjs-client": "^1.6.1",
    "taiga-ui": "^5.4.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.2.0",
    "@angular/cli": "^20.2.0",
    "@angular/compiler-cli": "^20.2.0",
    "@playwright/test": "^1.60.0",
    "@types/jasmine": "~5.1.0",
    "@types/sockjs-client": "^1.5.4",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  }
}
